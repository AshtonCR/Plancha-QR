---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import { listQrs } from "../lib/qrs";

const qrs = await listQrs();
const userEmail = Astro.locals.userEmail;

function formatDateTime(iso: string) {
  const date = new Date(iso).toLocaleDateString("es-AR", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  });
  const time = new Date(iso).toLocaleTimeString("es-AR", {
    hour: "2-digit",
    minute: "2-digit",
  });
  return `${date} ${time}`;
}
---

<Layout title="Panel — Plancha QR">
  <main class="min-h-screen px-6 py-10">
    <div class="mx-auto max-w-4xl">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="text-xs font-medium tracking-wide text-lime-400">PANEL</p>
          <h1 class="mt-1 text-2xl font-bold text-white">Tus códigos</h1>
          {userEmail && <p class="mt-1 text-xs text-neutral-500">{userEmail}</p>}
        </div>
        <div class="flex shrink-0 items-center gap-3">
          <form method="POST" action="/api/logout">
            <button
              type="submit"
              class="rounded-lg border border-neutral-800 px-3 py-2.5 text-sm text-neutral-400 hover:text-white"
            >
              Salir
            </button>
          </form>
          <a
            href="/panel/nueva"
            class="rounded-lg bg-lime-400 px-4 py-2.5 text-sm font-semibold text-neutral-950 hover:bg-lime-300"
          >
            Generar plancha nueva
          </a>
        </div>
      </div>

      {
        qrs.length === 0 ? (
          <div class="mt-10 rounded-xl border border-dashed border-neutral-800 px-6 py-12 text-center">
            <p class="text-sm text-neutral-400">
              Todavía no generaste ningún código.
            </p>
            <a
              href="/panel/nueva"
              class="mt-3 inline-block text-sm font-medium text-lime-400 underline underline-offset-4"
            >
              Generar la primera plancha
            </a>
          </div>
        ) : (
          <>
            <div
              id="bulk-bar"
              class="mt-6 hidden items-center justify-between rounded-lg border border-lime-400/30 bg-lime-400/10 px-4 py-2.5"
            >
              <p class="text-sm text-lime-300">
                <span id="selected-count">0</span> seleccionados
              </p>
              <div class="flex items-center gap-2">
                <button
                  id="bulk-release-btn"
                  type="button"
                  class="rounded-lg border border-neutral-700 px-3 py-1.5 text-xs font-semibold text-neutral-300 hover:border-neutral-500 hover:text-white"
                >
                  Liberar destino
                </button>
                <button
                  id="bulk-delete-btn"
                  type="button"
                  class="rounded-lg bg-red-500 px-3 py-1.5 text-xs font-semibold text-white hover:bg-red-400"
                >
                  Eliminar definitivamente
                </button>
              </div>
            </div>

            <div class="mt-6 overflow-x-auto rounded-xl border border-neutral-800">
              <table class="w-full text-left text-sm">
                <thead>
                  <tr class="border-b border-neutral-800 text-xs text-neutral-500">
                    <th class="w-10 px-4 py-3">
                      <input
                        id="select-all"
                        type="checkbox"
                        class="h-4 w-4 rounded border-neutral-700 bg-neutral-900 accent-lime-400"
                      />
                    </th>
                    <th class="px-4 py-3 font-medium">Código</th>
                    <th class="px-4 py-3 font-medium">Negocio</th>
                    <th class="px-4 py-3 font-medium">Destino</th>
                    <th class="px-4 py-3 font-medium">Creado</th>
                  </tr>
                </thead>
                <tbody>
                  {qrs.map((qr) => (
                    <tr
                      class="row border-b border-neutral-900 last:border-0 hover:bg-neutral-900/50"
                      data-row-code={qr.code}
                    >
                      <td class="px-4 py-3">
                        <input
                          type="checkbox"
                          class="row-checkbox h-4 w-4 rounded border-neutral-700 bg-neutral-900 accent-lime-400"
                          data-code={qr.code}
                        />
                      </td>
                      <td class="px-4 py-3">
                        <a
                          href={`/${qr.code}`}
                          class="font-mono text-lime-400 hover:underline"
                        >
                          {qr.code}
                        </a>
                      </td>
                      <td class="px-4 py-3">
                        <input
                          type="text"
                          class="label-input w-40 rounded-md border border-transparent bg-transparent px-2 py-1 text-neutral-300 outline-none hover:border-neutral-800 focus:border-lime-400 focus:bg-neutral-900"
                          placeholder="Sin nombre"
                          value={qr.label ?? ""}
                          data-code={qr.code}
                          data-original={qr.label ?? ""}
                        />
                      </td>
                      <td class="max-w-xs truncate px-4 py-3" data-destination-cell>
                        {qr.destination_url ? (
                          <span class="text-neutral-300">
                            {qr.destination_url}
                          </span>
                        ) : (
                          <span class="text-neutral-600">sin asignar</span>
                        )}
                      </td>
                      <td class="px-4 py-3 text-neutral-500">
                        {formatDateTime(qr.created_at)}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )
      }
    </div>
  </main>
</Layout>

<script>
	const selectAll = document.getElementById('select-all') as HTMLInputElement | null;
	const bulkBar = document.getElementById('bulk-bar');
	const selectedCount = document.getElementById('selected-count');
	const bulkDeleteBtn = document.getElementById('bulk-delete-btn');
	const bulkReleaseBtn = document.getElementById('bulk-release-btn');

	function getCheckboxes(): HTMLInputElement[] {
		return Array.from(document.querySelectorAll('.row-checkbox'));
	}

	function getSelectedCodes(): string[] {
		return getCheckboxes()
			.filter((cb) => cb.checked)
			.map((cb) => cb.getAttribute('data-code'))
			.filter((c): c is string => !!c);
	}

	function refreshBulkBar() {
		const checked = getCheckboxes().filter((cb) => cb.checked);
		if (selectedCount) selectedCount.textContent = String(checked.length);
		if (bulkBar) {
			bulkBar.classList.toggle('hidden', checked.length === 0);
			bulkBar.classList.toggle('flex', checked.length > 0);
		}
		if (selectAll) {
			const all = getCheckboxes();
			selectAll.checked = all.length > 0 && checked.length === all.length;
			selectAll.indeterminate = checked.length > 0 && checked.length < all.length;
		}
	}

	selectAll?.addEventListener('change', () => {
		getCheckboxes().forEach((cb) => (cb.checked = selectAll.checked));
		refreshBulkBar();
	});

	getCheckboxes().forEach((cb) => cb.addEventListener('change', refreshBulkBar));

	bulkReleaseBtn?.addEventListener('click', async () => {
		const codes = getSelectedCodes();
		if (codes.length === 0) return;

		const plural = codes.length > 1;
		const confirmed = window.confirm(
			`¿Liberar ${codes.length} código${plural ? 's' : ''}? Se borra el destino guardado y ${plural ? 'vuelven' : 'vuelve'} a quedar sin asignar. El impreso sigue funcionando y se puede configurar de nuevo escaneándolo.`
		);
		if (!confirmed) return;

		bulkReleaseBtn.setAttribute('disabled', 'true');

		const results = await Promise.allSettled(
			codes.map((code) =>
				fetch(`/api/qrs/${encodeURIComponent(code)}`, {
					method: 'PATCH',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ destination_url: null }),
				})
			)
		);

		let failed = 0;
		results.forEach((result, i) => {
			if (result.status === 'fulfilled' && result.value.ok) {
				const cell = document.querySelector(
					`tr[data-row-code="${codes[i]}"] [data-destination-cell]`
				);
				if (cell) cell.innerHTML = '<span class="text-neutral-600">sin asignar</span>';
			} else {
				failed++;
			}
		});

		bulkReleaseBtn.removeAttribute('disabled');

		if (failed > 0) {
			window.alert(`No se pudieron liberar ${failed} código(s). Probá de nuevo.`);
		}
	});

	bulkDeleteBtn?.addEventListener('click', async () => {
		const codes = getSelectedCodes();
		if (codes.length === 0) return;

		const plural = codes.length > 1;
		const confirmed = window.confirm(
			`¿Eliminar ${codes.length} código${plural ? 's' : ''} para siempre? El impreso queda inservible: al escanearlo dirá que el código no existe y no hay forma de recuperarlo. Si solo querés reutilizarlo, usá "Liberar destino".`
		);
		if (!confirmed) return;

		bulkDeleteBtn.setAttribute('disabled', 'true');

		const results = await Promise.allSettled(
			codes.map((code) => fetch(`/api/qrs/${encodeURIComponent(code)}`, { method: 'DELETE' }))
		);

		let failed = 0;
		results.forEach((result, i) => {
			const code = codes[i];
			const succeeded = result.status === 'fulfilled' && result.value.ok;
			if (succeeded) {
				document.querySelector(`tr[data-row-code="${code}"]`)?.remove();
			} else {
				failed++;
			}
		});

		bulkDeleteBtn.removeAttribute('disabled');
		refreshBulkBar();

		if (failed > 0) {
			window.alert(`No se pudieron eliminar ${failed} código(s). Probá de nuevo.`);
		}
	});

	document.querySelectorAll('.label-input').forEach((input) => {
		const el = input as HTMLInputElement;

		async function saveLabel() {
			const code = el.getAttribute('data-code');
			const original = el.getAttribute('data-original') ?? '';
			const value = el.value.trim();
			if (!code || value === original) return;

			el.disabled = true;
			try {
				const res = await fetch(`/api/qrs/${encodeURIComponent(code)}`, {
					method: 'PATCH',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ label: value === '' ? null : value }),
				});
				const data = await res.json();

				if (!res.ok || !data.ok) {
					window.alert('No se pudo guardar el nombre del negocio.');
					el.value = original;
				} else {
					el.setAttribute('data-original', value);
				}
			} catch {
				window.alert('No se pudo guardar el nombre del negocio. Revisá tu conexión.');
				el.value = original;
			} finally {
				el.disabled = false;
			}
		}

		el.addEventListener('blur', saveLabel);
		el.addEventListener('keydown', (e) => {
			if (e.key === 'Enter') el.blur();
		});
	});
</script>
