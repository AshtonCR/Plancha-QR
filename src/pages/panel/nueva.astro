---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
---

<Layout title="Generar plancha — Plancha QR">
	<main class="min-h-screen px-6 py-10 print:p-0">
		<div class="mx-auto max-w-3xl">
			<!-- Step 1: choose quantity -->
			<div id="form-step">
				<a href="/panel" class="text-xs text-neutral-500 hover:text-neutral-300">&larr; Volver al panel</a>
				<p class="mt-4 text-xs font-medium tracking-wide text-brand">NUEVA PLANCHA</p>
				<h1 class="mt-1 text-2xl font-bold text-white">¿Cuántos códigos querés generar?</h1>
				<p class="mt-2 text-sm text-neutral-400">
					Se crean sin destino asignado. Los asignás después, escaneando cada uno.
				</p>

				<form id="batch-form" class="mt-6 flex max-w-xs gap-3">
					<input
						id="count"
						name="count"
						type="number"
						min="1"
						max="200"
						value="10"
						required
						class="w-24 rounded-lg border border-neutral-800 bg-neutral-900 px-3 py-2.5 text-sm text-white outline-none focus:border-brand"
					/>
					<button
						type="submit"
						class="rounded-lg bg-brand px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-deep"
					>
						Generar
					</button>
				</form>
				<p id="batch-error" class="mt-3 hidden text-xs text-red-400"></p>
			</div>

			<!-- Step 2: printable A4 sheet -->
			<div id="sheet-step" class="hidden">
				<div class="flex items-center justify-between print:hidden">
					<p class="text-sm text-neutral-400">
						<span id="sheet-count"></span> códigos generados. Listos para imprimir.
					</p>
					<button
						id="print-btn"
						type="button"
						class="rounded-lg bg-brand px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-deep"
					>
						Imprimir / Descargar PDF
					</button>
				</div>

				<div class="mt-4 flex flex-wrap items-start gap-6 rounded-lg border border-neutral-800 bg-neutral-900/50 p-3 print:hidden">
					<div>
						<label class="mb-1 block text-xs font-medium text-neutral-400">COLOR DEL QR</label>
						<div class="flex items-center gap-2">
							<input
								id="qr-color"
								type="color"
								value="#000000"
								class="h-9 w-9 cursor-pointer rounded border border-neutral-700 bg-neutral-900 p-0.5"
							/>
							<div id="qr-color-presets" class="flex gap-1.5">
								<button
									type="button"
									class="preset-color h-6 w-6 rounded-full border border-neutral-700"
									data-color="#000000"
									style="background:#000000"
									aria-label="Negro"
								></button>
								<button
									type="button"
									class="preset-color h-6 w-6 rounded-full border border-neutral-700"
									data-color="#202124"
									style="background:#202124"
									aria-label="Gris oscuro"
								></button>
								<button
									type="button"
									class="preset-color h-6 w-6 rounded-full border border-neutral-700"
									data-color="#174EA6"
									style="background:#174EA6"
									aria-label="Azul"
								></button>
								<button
									type="button"
									class="preset-color h-6 w-6 rounded-full border border-neutral-700"
									data-color="#0D652D"
									style="background:#0D652D"
									aria-label="Verde"
								></button>
							</div>
						</div>
						<p id="contrast-warning" class="mt-1.5 hidden max-w-[220px] text-xs text-amber-400">
							Estos colores tienen poco contraste entre sí y el QR puede no escanear bien.
						</p>
					</div>

					<div>
						<label for="qr-bg" class="mb-1 block text-xs font-medium text-neutral-400">
							FONDO DEL QR
						</label>
						<input
							id="qr-bg"
							type="color"
							value="#ffffff"
							class="h-9 w-9 cursor-pointer rounded border border-neutral-700 bg-neutral-900 p-0.5"
						/>
					</div>

					<div>
						<label for="qr-size" class="mb-1 block text-xs font-medium text-neutral-400">
							TAMAÑO (CM)
						</label>
						<input
							id="qr-size"
							type="number"
							min="2"
							max="15"
							step="0.1"
							value="3"
							class="w-24 rounded-lg border border-neutral-800 bg-neutral-900 px-3 py-2 text-sm text-white outline-none focus:border-brand"
						/>
						<p class="mt-1.5 max-w-[220px] text-xs text-neutral-500">
							Incluye el margen alrededor del código (zona de silencio), del color de fondo
							elegido — necesario para que escanee bien.
						</p>
					</div>

					<div>
						<label for="qr-margin" class="mb-1 block text-xs font-medium text-neutral-400">
							ZONA DE SILENCIO (MÓDULOS)
						</label>
						<input
							id="qr-margin"
							type="number"
							min="0"
							max="10"
							step="1"
							value="1"
							class="w-24 rounded-lg border border-neutral-800 bg-neutral-900 px-3 py-2 text-sm text-white outline-none focus:border-brand"
						/>
						<p class="mt-1.5 max-w-[220px] text-xs text-neutral-500">
							Margen en blanco (o del color de fondo) alrededor del código. Muy bajo puede hacer
							que algunos lectores no lo reconozcan.
						</p>
					</div>
				</div>

				<div
					id="sheet-grid"
					class="mt-4 grid gap-6 rounded-xl border border-neutral-800 bg-white p-8 print:mt-0 print:gap-4 print:rounded-none print:border-0 print:p-4"
				>
				</div>

				<p class="mt-3 text-xs text-neutral-500 print:hidden">
					Al imprimir, usá escala 100% (no "Ajustar a página") para que el tamaño en cm salga
					exacto.
				</p>

				<a href="/panel" class="mt-6 inline-block text-xs text-neutral-500 hover:text-neutral-300 print:hidden">
					&larr; Volver al panel
				</a>
			</div>
		</div>
	</main>
</Layout>

<style>
	@media print {
		:global(body) {
			background: white !important;
		}
	}
</style>

<script>
	import QRCode from 'qrcode';

	const formStep = document.getElementById('form-step');
	const sheetStep = document.getElementById('sheet-step');
	const batchForm = document.getElementById('batch-form') as HTMLFormElement;
	const countInput = document.getElementById('count') as HTMLInputElement;
	const batchError = document.getElementById('batch-error');
	const sheetGrid = document.getElementById('sheet-grid') as HTMLDivElement;
	const sheetCount = document.getElementById('sheet-count');
	const printBtn = document.getElementById('print-btn');
	const colorInput = document.getElementById('qr-color') as HTMLInputElement;
	const colorPresets = document.querySelectorAll<HTMLButtonElement>('.preset-color');
	const bgInput = document.getElementById('qr-bg') as HTMLInputElement;
	const contrastWarning = document.getElementById('contrast-warning');
	const sizeInput = document.getElementById('qr-size') as HTMLInputElement;
	const marginInput = document.getElementById('qr-margin') as HTMLInputElement;

	// Codes already exist in the database once the batch is created; color, fondo,
	// tamaño y margen son puramente opciones de renderizado, así que cambiarlos
	// solo repinta los mismos códigos en vez de pegarle a la API (que gastaría un
	// batch nuevo).
	let currentCodes: { code: string }[] = [];

	function parseSizeCm(): number {
		const value = Number(sizeInput.value);
		if (!Number.isFinite(value)) return 3;
		return Math.min(15, Math.max(2, value));
	}

	function parseMargin(): number {
		const value = Number(marginInput.value);
		if (!Number.isFinite(value)) return 1;
		return Math.min(10, Math.max(0, Math.round(value)));
	}

	/** WCAG relative luminance of a `#rrggbb` color, 0 (black) to 1 (white). */
	function relativeLuminance(hex: string): number {
		const n = parseInt(hex.slice(1), 16);
		const channels = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map((c) => {
			const s = c / 255;
			return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
		});
		return 0.2126 * channels[0] + 0.7152 * channels[1] + 0.0722 * channels[2];
	}

	/** Contrast ratio between two `#rrggbb` colors (1 to 21). */
	function contrastRatio(hexA: string, hexB: string): number {
		const [lighter, darker] = [relativeLuminance(hexA), relativeLuminance(hexB)].sort(
			(a, b) => b - a
		);
		return (lighter + 0.05) / (darker + 0.05);
	}

	function updateColorUi() {
		const color = colorInput.value;
		const bg = bgInput.value;
		contrastWarning?.classList.toggle('hidden', contrastRatio(color, bg) >= 4.5);
		colorPresets.forEach((btn) => {
			const isActive = btn.dataset.color?.toLowerCase() === color.toLowerCase();
			btn.classList.toggle('ring-2', isActive);
			btn.classList.toggle('ring-white', isActive);
		});
	}

	async function renderSheet() {
		const color = colorInput.value;
		const bg = bgInput.value;
		const sizeCm = parseSizeCm();
		const margin = parseMargin();
		// ~118 px/cm (≈300dpi) so the code stays crisp at whatever size gets printed.
		const pxWidth = Math.min(1600, Math.max(160, Math.round(sizeCm * 118)));

		sheetGrid.style.gridTemplateColumns = `repeat(auto-fill, ${sizeCm}cm)`;
		sheetGrid.innerHTML = '';

		const origin = window.location.origin;
		for (const item of currentCodes) {
			const url = `${origin}/${item.code}`;
			const dataUrl = await QRCode.toDataURL(url, {
				margin,
				width: pxWidth,
				color: { dark: color, light: bg },
			});

			const cell = document.createElement('div');
			cell.className = 'flex flex-col items-center gap-2 break-inside-avoid';
			cell.innerHTML = `
				<img src="${dataUrl}" alt="QR ${item.code}" style="width:${sizeCm}cm;height:${sizeCm}cm" />
				<span class="font-mono text-xs text-neutral-900">${item.code}</span>
			`;
			sheetGrid.appendChild(cell);
		}
	}

	batchForm.addEventListener('submit', async (e) => {
		e.preventDefault();
		batchError?.classList.add('hidden');
		const submitBtn = batchForm.querySelector('button[type="submit"]') as HTMLButtonElement;
		submitBtn.disabled = true;

		try {
			const res = await fetch('/api/qrs/batch', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ count: Number(countInput.value) }),
			});
			const data = await res.json();

			if (!res.ok || !data.ok) {
				if (batchError) {
					batchError.textContent = 'No se pudo generar la plancha. Probá con una cantidad más chica.';
					batchError.classList.remove('hidden');
				}
				submitBtn.disabled = false;
				return;
			}

			currentCodes = data.codes as { code: string }[];
			await renderSheet();

			if (sheetCount) sheetCount.textContent = String(currentCodes.length);
			formStep?.classList.add('hidden');
			sheetStep?.classList.remove('hidden');
		} catch {
			if (batchError) {
				batchError.textContent = 'No se pudo generar la plancha. Revisá tu conexión.';
				batchError.classList.remove('hidden');
			}
			submitBtn.disabled = false;
		}
	});

	colorInput.addEventListener('input', () => {
		updateColorUi();
		renderSheet();
	});

	colorPresets.forEach((btn) => {
		btn.addEventListener('click', () => {
			const color = btn.dataset.color;
			if (!color) return;
			colorInput.value = color;
			updateColorUi();
			renderSheet();
		});
	});

	bgInput.addEventListener('input', () => {
		updateColorUi();
		renderSheet();
	});

	// `change` (not `input`) so typing each digit doesn't trigger a re-render per
	// keystroke — only once the value is committed.
	sizeInput.addEventListener('change', () => {
		renderSheet();
	});

	marginInput.addEventListener('change', () => {
		renderSheet();
	});

	updateColorUi();

	printBtn?.addEventListener('click', () => {
		window.print();
	});
</script>
