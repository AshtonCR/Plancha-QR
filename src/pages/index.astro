---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Plancha QR">
	<main class="flex min-h-screen items-center justify-center px-6">
		<div class="text-center">
			<p class="text-xs font-medium tracking-wide text-lime-400">PLANCHA QR</p>
			<h1 class="mt-2 text-2xl font-bold text-white">Códigos QR dinámicos</h1>
			<a
				href="/panel"
				class="mt-6 inline-block rounded-lg bg-lime-400 px-5 py-2.5 text-sm font-semibold text-neutral-950 hover:bg-lime-300"
			>
				Ir al panel
			</a>
		</div>
	</main>
</Layout>
