---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import {
	SESSION_COOKIE,
	SESSION_MAX_AGE_SECONDS,
	authConfigIssues,
	createSessionToken,
	isAuthConfigured,
	safeNextPath,
	verifyCredentials,
} from '../lib/auth';

const CONFIG_ISSUE_MESSAGES = {
	missing_session_secret:
		'Falta SESSION_SECRET y también SUPABASE_SERVICE_ROLE_KEY, de la que se deriva cuando la primera no está.',
	missing_panel_users: 'Falta la variable PANEL_USERS.',
	invalid_panel_users_json: 'PANEL_USERS está definida pero no es un JSON válido.',
	empty_panel_users:
		'PANEL_USERS es un JSON válido pero no tiene ninguna cuenta con "email" y "password".',
} as const;

const next = safeNextPath(Astro.url.searchParams.get('next'));

if (Astro.locals.isAuthed) {
	return Astro.redirect(next);
}

let error = '';
let email = '';

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	email = String(form.get('email') ?? '');
	const signedInEmail = verifyCredentials(email, form.get('password'));

	if (signedInEmail) {
		Astro.cookies.set(SESSION_COOKIE, createSessionToken(signedInEmail), {
			httpOnly: true,
			secure: import.meta.env.PROD,
			sameSite: 'lax',
			path: '/',
			maxAge: SESSION_MAX_AGE_SECONDS,
		});
		return Astro.redirect(safeNextPath(String(form.get('next') ?? next)));
	}

	error = isAuthConfigured ? 'Correo o contraseña incorrectos.' : '';
}
---

<Layout title="Ingresar — Plancha QR">
	<main class="flex min-h-screen items-center justify-center px-6">
		<div class="w-full max-w-sm">
			<p class="text-xs font-medium tracking-wide text-lime-400">PLANCHA QR</p>
			<h1 class="mt-2 text-2xl font-bold text-white">Ingresá al panel</h1>

			{
				!isAuthConfigured && (
					<div class="mt-6 rounded-lg border border-red-900 bg-red-950/40 p-4">
						<p class="text-xs font-medium tracking-wide text-red-400">
							ACCESO NO CONFIGURADO
						</p>
						<ul class="mt-2 space-y-1 text-xs text-neutral-300">
							{authConfigIssues.map((issue) => (
								<li>· {CONFIG_ISSUE_MESSAGES[issue]}</li>
							))}
						</ul>
						<p class="mt-2 text-xs text-neutral-500">
							Definilas en Vercel y volvé a desplegar: cambiar una variable no afecta a un
							deployment ya creado.
						</p>
					</div>
				)
			}

			<form method="POST" class="mt-6 space-y-3">
				<input type="hidden" name="next" value={next} />
				<div>
					<label for="email" class="mb-1 block text-xs font-medium text-neutral-400">CORREO</label>
					<input
						id="email"
						name="email"
						type="email"
						autocomplete="username"
						value={email}
						required
						class="w-full rounded-lg border border-neutral-800 bg-neutral-900 px-4 py-3 text-sm text-white outline-none placeholder:text-neutral-600 focus:border-lime-400"
					/>
				</div>
				<div>
					<label for="password" class="mb-1 block text-xs font-medium text-neutral-400">
						CONTRASEÑA
					</label>
					<input
						id="password"
						name="password"
						type="password"
						autocomplete="current-password"
						required
						class="w-full rounded-lg border border-neutral-800 bg-neutral-900 px-4 py-3 text-sm text-white outline-none focus:border-lime-400"
					/>
				</div>

				{error && <p class="text-xs text-red-400">{error}</p>}

				<button
					type="submit"
					class="w-full rounded-lg bg-lime-400 px-4 py-3 text-sm font-semibold text-neutral-950 transition hover:bg-lime-300"
				>
					Entrar
				</button>
			</form>
		</div>
	</main>
</Layout>
