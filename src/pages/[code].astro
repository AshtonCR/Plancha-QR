---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getQrByCode } from '../lib/qrs';

const { code } = Astro.params;
const qr = code ? await getQrByCode(code) : null;
const isAssigned = !!qr?.destination_url;
// Re-pointing a live code is admin-only, so the scan page only offers it to a
// signed-in admin — an anonymous visitor would just get a 403 from the API.
const canReassign = Astro.locals.isAuthed;
---

<Layout title={qr ? `plancha.ar/${code}` : 'Código no encontrado'}>
	{isAssigned && (
		<meta slot="head" http-equiv="refresh" content={`3;url=${qr!.destination_url}`} />
	)}

	{!qr && (
		<main class="flex min-h-screen items-center justify-center px-6">
			<div class="max-w-sm text-center">
				<p class="text-sm font-medium tracking-wide text-brand">CÓDIGO INVÁLIDO</p>
				<h1 class="mt-3 text-2xl font-bold text-white">Este código no existe</h1>
				<p class="mt-2 text-sm text-neutral-400">
					Revisá que la URL sea la que está impresa en el cartel.
				</p>
			</div>
		</main>
	)}

	{qr && (
		<main class="flex min-h-screen items-center justify-center px-6">
			<div class="w-full max-w-sm">
				<!-- Redirect / animation state -->
				<div id="redirect-state" class={isAssigned ? '' : 'hidden'}>
					<div class="flex flex-col items-center text-center">
						<div id="redirect-mark" class="relative flex h-14 w-14 items-center justify-center text-brand">
							<span class="redirect-mark-ring" aria-hidden="true"></span>
							<svg viewBox="0 0 44 44" fill="none" class="relative h-14 w-14" aria-hidden="true">
								<path
									class="mark-arc mark-arc-1"
									pathLength="1"
									stroke="currentColor"
									stroke-width="3.2"
									stroke-linecap="round"
									d="M12 29C12 21.82 17.82 16 25 16"
								/>
								<path
									class="mark-arc mark-arc-2"
									pathLength="1"
									stroke="currentColor"
									stroke-width="3.2"
									stroke-linecap="round"
									d="M6 29C6 18.51 14.51 10 25 10"
								/>
								<path
									class="mark-arc mark-arc-3"
									pathLength="1"
									stroke="currentColor"
									stroke-width="3.2"
									stroke-linecap="round"
									d="M0 29C0 15.19 11.19 4 25 4"
								/>
								<circle class="mark-dot" cx="29" cy="29" r="4" fill="currentColor" />
							</svg>
						</div>
						<p class="mt-6 text-sm text-neutral-400">Te llevamos a tu destino…</p>
						<p class="mt-1 font-mono text-xs text-neutral-600">{code}</p>
						{canReassign && (
							<button
								id="change-destination-btn"
								type="button"
								class="mt-8 text-xs font-medium text-neutral-500 underline underline-offset-4 hover:text-brand"
							>
								Cambiar destino
							</button>
						)}
					</div>
				</div>

				<!-- Config / edit form state -->
				<div id="config-state" class={isAssigned ? 'hidden' : ''}>
					<p class="text-xs font-medium tracking-wide text-brand">
						CÓDIGO {code} · {isAssigned ? 'ASIGNADO' : 'SIN ASIGNAR'}
					</p>
					<h1 class="mt-3 text-2xl font-bold text-white">
						¿A dónde tiene que llevar este código?
					</h1>

					<form id="config-form" class="mt-6 space-y-3">
						<div>
							<label for="destination" class="mb-1 block text-xs font-medium text-neutral-400">
								DESTINO
							</label>
							<input
								id="destination"
								name="destination"
								type="text"
								inputmode="url"
								placeholder="https://instagram.com/tu.negocio"
								value={qr.destination_url ?? ''}
								required
								class="w-full rounded-lg border border-neutral-800 bg-neutral-900 px-4 py-3 text-sm text-white outline-none placeholder:text-neutral-600 focus:border-brand"
							/>
						</div>
						<p id="form-error" class="hidden text-xs text-red-400"></p>
						<button
							type="submit"
							class="w-full rounded-lg bg-brand px-4 py-3 text-sm font-semibold text-white transition hover:bg-brand-deep"
						>
							Guardar y activar
						</button>
						{isAssigned && (
							<button
								id="cancel-edit-btn"
								type="button"
								class="w-full rounded-lg border border-neutral-800 px-4 py-2.5 text-sm text-neutral-400 hover:text-white"
							>
								Cancelar
							</button>
						)}
					</form>
				</div>

				<!-- Confirmation state -->
				<div id="done-state" class="hidden text-center">
					<div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-brand">
						<svg viewBox="0 0 24 24" class="h-7 w-7 text-white" fill="none" stroke="currentColor" stroke-width="3">
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
						</svg>
					</div>
					<p class="mt-4 text-xs font-medium tracking-wide text-brand">LISTO</p>
					<p class="mt-1 text-sm text-neutral-300">
						El código <span class="font-mono text-white">{code}</span> ya lleva a
						<span id="done-destination" class="block truncate text-white"></span>
					</p>
					<a id="done-link" href="#" class="mt-6 inline-block text-xs font-medium text-brand underline underline-offset-4">
						Ir ahora
					</a>
				</div>
			</div>
		</main>
	)}
</Layout>

<style>
	/* Declarative on purpose: the redirect page must not depend on a JS animation
	   library loading before it can forward the scan.

	   The mark is Simpletouch's signal isotype (three concentric arcs + a dot),
	   not a spin: the arcs trace themselves in like a signal locking on, the dot
	   pops once they land, and a ring pulses outward right as the JS redirect
	   fires at 900ms — "you're connected, on your way". */
	@keyframes redirect-mark-in {
		0% {
			transform: scale(0.7);
			opacity: 0;
		}
		100% {
			transform: scale(1);
			opacity: 1;
		}
	}

	@keyframes redirect-arc-trace {
		0% {
			stroke-dashoffset: 1;
			opacity: 0;
		}
		15% {
			opacity: 1;
		}
		100% {
			stroke-dashoffset: 0;
			opacity: 1;
		}
	}

	@keyframes redirect-dot-pop {
		0%,
		55% {
			transform: scale(0);
			opacity: 0;
		}
		75% {
			transform: scale(1.3);
			opacity: 1;
		}
		100% {
			transform: scale(1);
			opacity: 1;
		}
	}

	@keyframes redirect-ring-pulse {
		0%,
		45% {
			transform: scale(0.8);
			opacity: 0;
		}
		65% {
			opacity: 0.45;
		}
		100% {
			transform: scale(1.7);
			opacity: 0;
		}
	}

	#redirect-mark {
		animation: redirect-mark-in 0.35s ease-out forwards;
	}

	.mark-arc {
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
		opacity: 0;
		animation: redirect-arc-trace 0.55s ease-out forwards;
	}
	.mark-arc-1 {
		animation-delay: 0.1s;
	}
	.mark-arc-2 {
		animation-delay: 0.22s;
	}
	.mark-arc-3 {
		animation-delay: 0.34s;
	}

	.mark-dot {
		transform-origin: 29px 29px;
		transform-box: fill-box;
		opacity: 0;
		animation: redirect-dot-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
		animation-delay: 0.55s;
	}

	.redirect-mark-ring {
		position: absolute;
		inset: 0;
		border-radius: 9999px;
		border: 2px solid var(--color-brand);
		opacity: 0;
		animation: redirect-ring-pulse 0.5s ease-out forwards;
		animation-delay: 0.55s;
	}

	@media (prefers-reduced-motion: reduce) {
		#redirect-mark,
		.mark-arc,
		.mark-dot,
		.redirect-mark-ring {
			animation: none;
			opacity: 1;
			transform: none;
		}
		.mark-arc {
			stroke-dashoffset: 0;
		}
	}
</style>

{qr && (
	<script define:vars={{ code, destinationUrl: qr.destination_url, isAssigned }}>
		const redirectState = document.getElementById('redirect-state');
		const configState = document.getElementById('config-state');
		const doneState = document.getElementById('done-state');
		const form = document.getElementById('config-form');
		const destinationInput = document.getElementById('destination');
		const formError = document.getElementById('form-error');
		const changeBtn = document.getElementById('change-destination-btn');
		const cancelBtn = document.getElementById('cancel-edit-btn');

		let redirectTimer;

		function showConfig() {
			if (redirectTimer) window.clearTimeout(redirectTimer);
			redirectState.classList.add('hidden');
			doneState.classList.add('hidden');
			configState.classList.remove('hidden');
		}

		function showRedirect() {
			// Scheduled first and with nothing that can throw before it: this page exists
			// only to forward the scan, so the jump must not depend on anything else.
			redirectTimer = window.setTimeout(() => {
				window.location.replace(destinationUrl);
			}, 900);

			configState.classList.add('hidden');
			doneState.classList.add('hidden');
			redirectState.classList.remove('hidden');
		}

		if (isAssigned) {
			showRedirect();
		}

		changeBtn?.addEventListener('click', showConfig);
		cancelBtn?.addEventListener('click', () => {
			if (isAssigned) showRedirect();
		});

		form?.addEventListener('submit', async (e) => {
			e.preventDefault();
			formError.classList.add('hidden');
			const destination = destinationInput.value.trim();

			const submitBtn = form.querySelector('button[type="submit"]');
			submitBtn.disabled = true;

			try {
				const res = await fetch(`/api/qrs/${encodeURIComponent(code)}`, {
					method: 'PATCH',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ destination_url: destination }),
				});
				const data = await res.json();

				if (!res.ok || !data.ok) {
					if (data.error === 'invalid_url') {
						formError.textContent =
							'Ese link no parece válido. Tiene que empezar con http:// o https://';
					} else if (data.error === 'already_assigned' || data.error === 'unauthorized') {
						formError.textContent =
							'Este código ya tiene destino. Para cambiarlo, ingresá al panel.';
					} else {
						formError.textContent = 'No se pudo guardar. Probá de nuevo.';
					}
					formError.classList.remove('hidden');
					submitBtn.disabled = false;
					return;
				}

				configState.classList.add('hidden');
				doneState.classList.remove('hidden');
				document.getElementById('done-destination').textContent = data.destination_url;
				const doneLink = document.getElementById('done-link');
				doneLink.href = data.destination_url;

				window.setTimeout(() => {
					window.location.replace(data.destination_url);
				}, 1500);
			} catch {
				formError.textContent = 'No se pudo guardar. Revisá tu conexión.';
				formError.classList.remove('hidden');
				submitBtn.disabled = false;
			}
		});
	</script>
)}
